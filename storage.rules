rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function userRole() {
      return firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        ? firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role', '')
        : '';
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.get('role', '') == 'admin' ||
        userRole() == 'admin'
      );
    }

    function isTechnician() {
      return isAuthenticated() && (
        request.auth.token.get('role', '') == 'technician' ||
        userRole() == 'technician'
      );
    }

    function isDemoUser() {
      return isAuthenticated() && (
        (request.auth.token.email != null && request.auth.token.email.matches('^demo\\..*')) ||
        request.auth.token.get('isDemo', false) == true
      );
    }

    function isValidDocSize() {
      return request.resource != null && request.resource.size < 25 * 1024 * 1024;
    }

    function isValidImageSize() {
      return request.resource != null && request.resource.size < 5 * 1024 * 1024;
    }

    function isValidChatSize() {
      return request.resource != null && request.resource.size < 10 * 1024 * 1024;
    }

    function isImageFile() {
      return request.resource.contentType != null
          && request.resource.contentType.matches('image/.*');
    }

    function isDocOrImageFile() {
      return request.resource.contentType == null
          || request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf'
          || request.resource.contentType == 'application/msword'
          || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
          || request.resource.contentType == 'application/octet-stream';
    }

    // 1. العقود (contracts) - بدقة عالية حتى 25MB ويقرؤها وينزلها صاحب العقد أو الأدمن
    match /contracts/{userId}/{fileName} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isAdmin() && !isDemoUser() && isValidDocSize() && isDocOrImageFile();
      allow delete: if isAdmin() && !isDemoUser();
    }

    // 2. مستندات المستأجر الإضافية (documents) - خاصة بصاحب الحساب والأدمن فقط
    match /documents/{userId}/{fileName} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isAuthenticated()
                            && (request.auth.uid == userId || isAdmin())
                            && !isDemoUser()
                            && isValidDocSize()
                            && isDocOrImageFile();
      allow delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin()) && !isDemoUser();
    }

    // 3. صور طلبات الصيانة (tasks) - صور حصرية بحد أقصى 5MB لتوفير المساحة والترافيك
    match /tasks/{userId}/{fileName} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated()
                            && (request.auth.uid == userId || isAdmin())
                            && isValidImageSize()
                            && isImageFile();
      allow delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin()) && !isDemoUser();
    }

    // 4. صور إثبات إنجاز الصيانة (completions) - يرفعها الفني أو الأدمن كصور فقط بحد أقصى 5MB
    match /completions/{taskId}/{fileName} {
      allow read: if isAuthenticated();
      allow create, update: if (isTechnician() || isAdmin()) && isValidImageSize() && isImageFile();
      allow delete: if isAdmin() && !isDemoUser();
    }

    // 5. مرفقات وصور المحادثات (chats) - بحد أقصى 10MB
    match /chats/{chatId}/{fileName} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidChatSize() && isDocOrImageFile();
      allow update, delete: if isAdmin() && !isDemoUser();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
