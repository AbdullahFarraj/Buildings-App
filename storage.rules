rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // 1. العقود (contracts)
    match /contracts/{userId}/{fileName} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // 2. مستندات المستأجر الإضافية (documents)
    match /documents/{userId}/{fileName} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // 3. صور طلبات الصيانة (tasks)
    match /tasks/{userId}/{fileName} {
      allow read, write: if isAuthenticated();
    }

    // 4. صور إثبات إنجاز الصيانة (completions)
    match /completions/{taskId}/{fileName} {
      allow read, write: if isAuthenticated();
    }

    // 5. مرفقات وصور المحادثات (chats)
    match /chats/{chatId}/{fileName} {
      allow read, write: if isAuthenticated();
    }

    // إغلاق أي مسارات عشوائية أخرى
    match /{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
  }
}
