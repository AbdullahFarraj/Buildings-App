rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidSize() {
      return request.resource == null || request.resource.size < 25 * 1024 * 1024;
    }

    // 1. العقود (contracts)
    match /contracts/{userId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isValidSize();
    }

    // 2. مستندات المستأجر الإضافية (documents)
    match /documents/{userId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isValidSize();
    }

    // 3. صور طلبات الصيانة (tasks)
    match /tasks/{userId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isValidSize();
    }

    // 4. صور إثبات إنجاز الصيانة (completions)
    match /completions/{taskId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isValidSize();
    }

    // 5. مرفقات وصور المحادثات (chats)
    match /chats/{chatId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isValidSize();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
