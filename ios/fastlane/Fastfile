default_platform(:ios)

platform :ios do
  desc "Build and upload signed iOS release to TestFlight"
  lane :beta do
    # 1. Setup temporary CI keychain for certificates
    setup_ci

    # 2. Import Distribution Certificate & Private Key (.p12) into CI Keychain
    if ENV["BUILD_CERTIFICATE_BASE64"] && !ENV["BUILD_CERTIFICATE_BASE64"].empty?
      require "base64"
      cert_path = File.expand_path("../ios_distribution.p12")
      File.binwrite(cert_path, Base64.decode64(ENV["BUILD_CERTIFICATE_BASE64"]))
      import_certificate(
        certificate_path: cert_path,
        certificate_password: ENV["P12_PASSWORD"] || "",
        keychain_name: "fastlane_tmp_keychain"
      )
    end

    # 3. Authenticate using App Store Connect API Key
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY"],
      is_key_content_base64: false,
      in_house: false
    )

    # 4. Generate matching App Store Provisioning Profile
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.eliteliving.app",
      force: true
    )

    # 5. Build and sign the official App Store archive and IPA
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      clean: true,
      export_method: "app-store",
      output_directory: "../build/ios/ipa",
      output_name: "EliteLiving.ipa"
    )

    # 6. Upload directly to TestFlight
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
